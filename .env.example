# Copy to .env.local for local development. Never commit real values.
# Everything is optional locally: without DATABASE_URL the app uses an embedded
# Postgres (PGlite) in ./.data, and without BLOB_READ_WRITE_TOKEN uploads go to ./.data/uploads.

# --- AI (required for plans via AI, lessons, critiques) ---
OPENAI_API_KEY=
# Model for every AI call (default: gpt-5.5). Needs vision + structured outputs.
OPENAI_MODEL=gpt-5.5
# Global cap on model calls per UTC day, across all users (cost control)
AI_DAILY_CAP=400

# --- Database (required in production) ---
# Neon: use the pooled connection string. Supabase: use the transaction pooler (port 6543).
DATABASE_URL=

# --- Image storage (required in production) ---
# Vercel Blob read/write token. Created automatically when you add a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# --- Payments: Stripe TEST mode ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: use an existing recurring Price instead of the inline $12/month price
STRIPE_PRICE_ID=
# Optional: absolute base URL for Stripe redirects (defaults to the request origin)
APP_URL=

# --- Local demo only ---
# With no Stripe keys, lets "Unlock Plus" flip the account to paid instantly. Never set in production.
DEMO_INSTANT_UNLOCK=false
